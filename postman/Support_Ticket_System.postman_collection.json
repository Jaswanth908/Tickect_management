{
  "info": {
    "_postman_id": "9b1762e5-4f76-47b2-9d33-4f938d613e55",
    "name": "Support Ticket Management System API",
    "description": "Comprehensive Postman collection for testing the Support Ticket Management System REST APIs including authentication, role authorization, ticket lifecycle, and commenting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdTicketId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Customer123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Customer Login (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.customer@gmail.com\",\n  \"password\": \"Customer123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Agent Login (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"agentToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@support.com\",\n  \"password\": \"Agent123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Invalid Login (Rejected 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@support.com\",\n  \"password\": \"WrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Invalid Registration Input (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid-no-password-or-name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Current User Profile (GET /me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Tickets Management",
      "item": [
        {
          "name": "Create Ticket (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.ticket && jsonData.ticket.id) {",
                  "    pm.collectionVariables.set(\"createdTicketId\", jsonData.ticket.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"VPN connection drops intermittently\",\n  \"description\": \"Every 15 minutes the corporate VPN disconnects when accessing production servers.\",\n  \"priority\": \"High\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Get Tickets (Customer - Own Tickets Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Get Tickets (Agent - All Tickets + Filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?status=Open&priority=High",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                {
                  "key": "status",
                  "value": "Open"
                },
                {
                  "key": "priority",
                  "value": "High"
                }
              ]
            }
          }
        },
        {
          "name": "Get Ticket by ID (Authorized)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}"]
            }
          }
        },
        {
          "name": "Update Ticket Status & Priority (Agent)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"priority\": \"Urgent\",\n  \"assigned_to\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}"]
            }
          }
        },
        {
          "name": "Customer Forbidden from Updating Status (403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}"]
            }
          }
        },
        {
          "name": "Not-Found Ticket (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "999999"]
            }
          }
        },
        {
          "name": "Unauthorized API Request without Token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            }
          }
        },
        {
          "name": "Get Ticket Statistics (Agent Dashboard)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ticket Comments",
      "item": [
        {
          "name": "Add Comment to Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"We have verified the network logs and re-routed your VPN profile gateway. Please try reconnecting.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}", "comments"]
            }
          }
        },
        {
          "name": "Get Ticket Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{createdTicketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{createdTicketId}}", "comments"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Users & Agents Management",
      "item": [
        {
          "name": "Get Agents List (Agent Access Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?role=agent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "agent"
                }
              ]
            }
          }
        },
        {
          "name": "Customer Forbidden from Users List (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    }
  ]
}
